{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile information and stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "balance": { "type": "number" },
        "diamonds": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "matchesPlayed": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "balance", "diamonds"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial records for deposits, withdrawals, and entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["Deposit", "Withdrawal", "Tournament Entry", "Winning"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Completed", "Pending", "Failed"] },
        "date": { "type": "string", "format": "date-time" },
        "method": { "type": "string" },
        "tournamentId": { "type": "string" },
        "destination": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "type", "amount", "status", "date", "userId"]
    },
    "tournament": {
      "title": "Tournament",
      "description": "Tournament event details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "entryFee": { "type": "number" },
        "prizePool": { "type": "number" },
        "perKill": { "type": "number" },
        "slotsTotal": { "type": "number" },
        "slotsLeft": { "type": "number" },
        "startTime": { "type": "string" },
        "type": { "type": "string", "enum": ["Solos", "Duos", "Squads"] },
        "map": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["Upcoming", "Ongoing", "Completed"] }
      },
      "required": ["id", "title", "entryFee", "prizePool", "slotsTotal", "slotsLeft", "type", "startTime"]
    },
    "package": {
      "title": "Top-up Package",
      "description": "Customizable top-up options",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "price": { "type": "number" },
        "label": { "type": "string" }
      },
      "required": ["id", "amount", "price"]
    },
    "payment": {
      "title": "Payment Request",
      "description": "User payment submissions for verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "trxId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "method", "trxId", "status"]
    },
    "verified_code": {
      "title": "Verified Code",
      "description": "Pre-verified transaction IDs for instant redemption",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Used"] },
        "usedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "amount", "status"]
    },
    "withdrawal": {
      "title": "Withdrawal",
      "description": "User withdrawal requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "number": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "amount", "method", "number", "status"]
    },
    "notification": {
      "title": "Notification",
      "description": "User notifications for account updates and system messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["Info", "Success", "Warning", "Error", "Announcement", "Match", "Wallet"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message", "type", "read", "createdAt"]
    },
    "registration": {
      "title": "Tournament Registration",
      "description": "User registration for a specific tournament",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournamentId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "teamName": { "type": "string" },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gameUid": { "type": "string" },
              "gameName": { "type": "string" },
              "gameLevel": { "type": "string" }
            }
          }
        },
        "entryFee": { "type": "number" },
        "status": { "type": "string", "enum": ["Registered", "Canceled", "Refunded"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tournamentId", "userId", "userEmail", "userName", "players", "entryFee", "status", "createdAt"]
    },
    "event": {
      "title": "Game Event",
      "description": "Game event or announcement post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "link": { "type": "string" },
        "image": { "type": "string" },
        "status": { "type": "string", "enum": ["Upcoming", "Ongoing", "Completed", "Announcement"] },
        "type": { "type": "string", "enum": ["announcement", "upcoming", "ongoing", "event"] },
        "prizePool": { "type": "number" },
        "entryFee": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "status", "createdAt"]
    },
    "heroBanner": {
      "title": "Hero Banner",
      "description": "Banners for the home page slider (Live, Ads, etc)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "buttonText": { "type": "string" },
        "type": { "type": "string", "enum": ["Live", "Ad", "Announcement"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "image", "type", "isActive", "createdAt"]
    },
    "shopCategory": {
      "title": "Shop Category",
      "description": "Categories for digital items like Free Fire diamonds",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "isActive"]
    },
    "shopPackage": {
      "title": "Shop Package",
      "description": "Specific digital item packages (e.g., 100 diamonds)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "label": { "type": "string" },
        "price": { "type": "number" },
        "amount": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "categoryId", "label", "price", "isActive"]
    },
    "shopOrder": {
      "title": "Shop Order",
      "description": "Purchase record for shop items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryTitle": { "type": "string" },
        "packageId": { "type": "string" },
        "packageLabel": { "type": "string" },
        "price": { "type": "number" },
        "playerInfo": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Rejected"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "categoryId", "packageId", "price", "playerInfo", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile documents"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "User transaction history"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "notification",
      "description": "User notifications"
    },
    "/tournaments/{tournamentId}": {
      "schema": "tournament",
      "description": "Global tournament list"
    },
    "/packages/{packageId}": {
      "schema": "package",
      "description": "Top-up packages configurator"
    },
    "/payments/{paymentId}": {
      "schema": "payment",
      "description": "Payment verification requests"
    },
    "/verified_codes/{codeId}": {
      "schema": "verified_code",
      "description": "Pre-verified transaction codes for instant top-up"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "withdrawal",
      "description": "User withdrawal requests"
    },
    "/registrations/{registrationId}": {
      "schema": "registration",
      "description": "Tournament registrations"
    },
    "/events/{eventId}": {
      "schema": "event",
      "description": "Game events and announcements"
    },
    "/heroBanners/{bannerId}": {
      "schema": "heroBanner",
      "description": "Home page hero banners"
    },
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Global transaction log"
    },
    "/shop_categories/{categoryId}": {
      "schema": "shopCategory",
      "description": "Categories for the shop"
    },
    "/shop_packages/{packageId}": {
      "schema": "shopPackage",
      "description": "Packages for shop items"
    },
    "/shop_orders/{orderId}": {
      "schema": "shopOrder",
      "description": "User shop orders"
    }
  }
}
