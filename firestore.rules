rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "alifahmed7173638@gmail.com" || 
        request.auth.uid == "D43PNCXWKEWLIJ7KjQaHqx9Q5IH3" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // --- Entity Specific Validators ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'balance', 'diamonds']) &&
             data.uid == request.auth.uid &&
             data.balance is number && data.balance >= 0 &&
             data.diamonds is number && data.diamonds >= 0;
    }

    function isValidRegistration(data) {
      let requiredKeys = ['id', 'tournamentId', 'userId', 'userEmail', 'userName', 'players', 'entryFee', 'status', 'createdAt'];
      let optionalKeys = ['teamName'];
      let allKeys = requiredKeys.concat(optionalKeys);
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allKeys) &&
             data.id is string && data.id.size() <= 128 &&
             data.tournamentId is string && data.tournamentId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.players is list && data.players.size() >= 1 &&
             data.entryFee is number && data.entryFee >= 0 &&
             data.status == 'Registered' &&
             data.createdAt is timestamp;
    }

    function isValidTransaction(data) {
      let requiredKeys = ['id', 'type', 'amount', 'status', 'date', 'userId', 'createdAt'];
      let optionalKeys = ['tournamentId', 'method', 'destination'];
      let allKeys = requiredKeys.concat(optionalKeys);
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allKeys) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.amount is number &&
             data.status in ['Completed', 'Pending', 'Failed'] &&
             data.type in ['Deposit', 'Withdrawal', 'Tournament Entry', 'Winning'] &&
             data.createdAt is timestamp;
    }

    function isValidShopOrder(data) {
      let requiredKeys = ['id', 'userId', 'categoryId', 'packageId', 'price', 'playerInfo', 'status', 'createdAt', 'userEmail'];
      let optionalKeys = ['categoryTitle', 'packageLabel', 'updatedAt', 'adminNote', 'image'];
      let allKeys = requiredKeys.concat(optionalKeys);
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allKeys) &&
             data.userId == request.auth.uid &&
             data.playerInfo is string && data.playerInfo.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.status == 'Pending' &&
             data.createdAt is timestamp;
    }

    // --- Collection Routes ---

    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isAdmin() || (
        isOwner(userId) && (
          incoming().uid == userId &&
          // Explicitly list allowed fields to prevent privilege escalation
          incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'diamonds', 'matchesPlayed', 'totalEarnings', 'updatedAt', 'name', 'avatar'])
        )
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || isOwner(userId);
        allow update: if isAdmin() || (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']));
        allow delete: if isAdmin();
      }

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && (isAdmin() || isValidTransaction(incoming()));
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['slotsLeft', 'updatedAt']) &&
        incoming().slotsLeft == existing().slotsLeft - 1
      );
      allow create, delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && isValidRegistration(incoming()) && (
        exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId))
      ));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && isValidTransaction(incoming()));
      allow update, delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /verified_codes/{codeId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        incoming().status == "Used" &&
        incoming().usedBy == request.auth.uid &&
        existing().status == "Active" &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedBy'])
      );
      allow create, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_orders/{orderId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidShopOrder(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
